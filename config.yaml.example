# groundtruth global config (spec §11.2). Copy to ./config.yaml before `docker compose up`.
# NEVER put a secret here — reference an environment variable by name.

server:
  bind: 0.0.0.0
  port: 8000
  auth: none              # none | bearer
  mcp_endpoint: /mcp
  # bearer_token_env: GT_BEARER_TOKEN   # required when auth: bearer

state_dir: /var/lib/groundtruth   # a named volume, outside every vault repo
job_retention_days: 7
llm_logging: false                # prompts contain ingested content (§12.4)
llm_timeout_s: 60                 # HTTP timeout per LLM call; raise for a big local model

vaults:                            # registry seed: name -> repo root under /data
  work: /data/work

defaults:
  raw_archive: true
  auto_push: false
  allow_schema_writes: false
  models:
    default:
      base_url: http://host.docker.internal:11434/v1
      model: qwen2.5:14b
      api_key_env: GT_API_KEY
      # reasoning_effort: none   # sent as `reasoning_effort`; Ollama: `none` disables
      #                          # thinking for Qwen3-class models. OpenAI: minimal|low|medium|high.
      # params:                  # extra sampling params, merged into every call for the role.
      #   temperature: 0.2       # ingest is extraction + tool-calling — keep it low.
      #   presence_penalty: 0    # a high presence_penalty drops precise repeated terms.
      # (reasoning_effort + params are inherited by the roles below; params deep-merge.)
    # `model:` is NOT inherited: the three roles below keep these built-in models
    # unless you change them here. Only `organize` uses default's model.
    # See docs/local-model-tuning.md.
    tag:    {model: qwen2.5:7b}
    reduce: {model: qwen2.5:14b}
    answer: {model: qwen2.5:32b}
    # answer:                                # per-role overrides:
    #   model: qwen2.5:32b
    #   reasoning_effort: high               # thinking off elsewhere, on for answers
    #   params: {temperature: 0.4}           # merged over default's params
  limits:
    max_notes_per_ingest: 10
    max_note_bytes: 65536
    max_tool_calls: 30
    max_wall_clock_s: 60
    grep_max_matches: 50
    grep_max_bytes: 65536
    read_max_bytes: 32768
    vocab_max_bytes: 4096
    organize_max_attempts: 2   # re-prompt organize with the validator's rejection this many times before failing; 1 disables
